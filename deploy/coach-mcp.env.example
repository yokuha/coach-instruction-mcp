# Nach /etc/coach-mcp.env kopieren, chmod 600, root:root.

# Git-Remote (SSH-URL, Deploy Key) und Branch
COACH_REPO_URL=git@gitlab.com:<group>/<project>.git
COACH_BRANCH=main
COACH_REPO_DIR=/var/lib/coach-mcp/repo
COACH_SSH_KEY=/var/lib/coach-mcp/deploy_key

# Geheimer Teil der MCP-URL:  https://HOST/<COACH_URL_TOKEN>/mcp
# erzeugen mit:  openssl rand -hex 24
COACH_URL_TOKEN=HIER-EINTRAGEN

# GitLab-Webhook "Secret token" (Header X-Gitlab-Token); erzeugen mit: openssl rand -hex 24
COACH_WEBHOOK_TOKEN=HIER-EINTRAGEN

# Optional zusaetzlich: Authorization: Bearer ...  (claude.ai-Connectoren koennen das nicht senden,
# daher normalerweise leer lassen)
# COACH_BEARER_TOKEN=

# Schreib-Tools fuer Claudi: 0 = nur lesen (empfohlen zum Start), 1 = Aenderungen committen + pushen.
# Fuer 1 muss der Deploy Key in GitLab Schreibrechte haben.
COACH_WRITE=0

# Erlaubte Host-Header (Punycode-Schreibweise der Domain, mit Komma trennen). Schuetzt gegen DNS-Rebinding.
COACH_ALLOWED_HOSTS=coach-mcp.domain.tld

# Git-Autor fuer Commits von Claudi
COACH_GIT_NAME=Coach Claudi
COACH_GIT_EMAIL=coach-claudi@domain.tld

# Abgleich: bei Zugriff hoechstens alle 20 s, im Hintergrund alle 300 s (Webhook gleicht sofort ab)
COACH_SYNC_TTL=20
COACH_SYNC_INTERVAL=300

COACH_HOST=127.0.0.1
COACH_PORT=8765
