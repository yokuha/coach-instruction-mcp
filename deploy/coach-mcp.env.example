# Copy to /etc/coach-mcp.env, chmod 600, owned by root.

# Git remote of the instructions repository (SSH URL, deploy key) and branch
COACH_REPO_URL=git@gitlab.com:<group>/<project>.git
COACH_BRANCH=main
COACH_REPO_DIR=/var/lib/coach-mcp/repo
COACH_SSH_KEY=/var/lib/coach-mcp/deploy_key

# Secret part of the MCP URL:  https://HOST/<COACH_URL_TOKEN>/mcp
# generate with:  openssl rand -hex 24
COACH_URL_TOKEN=CHANGE-ME

# GitLab webhook "Secret token" (header X-Gitlab-Token); generate with: openssl rand -hex 24
# Leave empty if you don't use the webhook.
COACH_WEBHOOK_TOKEN=CHANGE-ME

# Optional additional check: Authorization: Bearer ...  (claude.ai connectors cannot send it,
# so normally leave this empty)
# COACH_BEARER_TOKEN=

# Write tools for Claude: 0 = read only (recommended to start), 1 = commit and push changes.
# For 1 the deploy key needs write access.
COACH_WRITE=0

# Allowed Host headers (domain in punycode, comma-separated). Protects against DNS rebinding.
COACH_ALLOWED_HOSTS=coach-mcp.example.com

# Git author for commits made by Claude
COACH_GIT_NAME=Coach Claudi
COACH_GIT_EMAIL=coach-claudi@example.com

# Sync: on access at most every 20 s, in the background every 300 s (the webhook syncs instantly)
COACH_SYNC_TTL=20
COACH_SYNC_INTERVAL=300

COACH_HOST=127.0.0.1
COACH_PORT=8765
